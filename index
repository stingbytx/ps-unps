function cashMovement(type){
  const s = activeShift();
  if (!s){ toast('Open a register first.', 'warn'); return; }
  formModal({
    title: type === 'in' ? 'Cash in' : 'Cash out', size:'narrow',
    fields:[
      {key:'amount', label:'Amount', type:'money', required:true, value:0},
      {key:'note', label:'Reason', full:true, placeholder: type === 'in' ? 'e.g. float top-up' : 'e.g. petty cash — stationery'}
    ],
    submit:'Record',
    onSubmit(v){
      if (v.amount <= 0) return false;
      s.cashMovements.push({type, amount:v.amount, note:v.note, at:new Date().toISOString()});
      audit('cash.' + (type === 'in' ? 'deposit' : 'withdrawal'), 'shift', s.id, {after:{amount:v.amount}, note:v.note});
      saveDB(); render(); toast('Cash movement recorded.'); return true;
    }
