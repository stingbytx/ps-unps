function employeeForm(emp){
  const e = emp || {};
  formModal({
    title: emp ? 'Edit employee' : 'New employee',
    fields:[
      {key:'name', label:'Full name', required:true},
      {key:'role', label:'Role', type:'select', options:Object.keys(ROLE_PERMS), value:e.role || 'Cashier'},
      {key:'phone', label:'Telephone', value:e.phone || ''},
