        if (q.length < 2){ out.innerHTML = '<div class="empty">Type at least two characters.</div>'; return; }
        const prods = DB.products.filter(p => p.active !== false && (p.name + ' ' + p.sku + ' ' + (p.barcode || '')).toLowerCase().includes(q)).slice(0, 5);
        const custs = DB.customers.filter(c => (c.name + ' ' + (c.phone || '')).toLowerCase().includes(q)).slice(0, 4);
        const sups = DB.suppliers.filter(s => s.name.toLowerCase().includes(q)).slice(0, 3);
        const sales = DB.sales.filter(s => (s.no + ' ' + (s.customerName || '')).toLowerCase().includes(q)).slice(0, 4);
        let html = '';
        const group = (title, items, render) => {
          if (!items.length) return;
          html += `<div class="tiny" style="margin:10px 0 4px;text-transform:uppercase;letter-spacing:.5px">${title}</div>${items.map(render).join('')}`;
        };
        group('Products', prods, p => `<button class="row" style="width:100%;text-align:left" data-goto-product="${attr(p.id)}"><div class="thumb">${esc(p.name.charAt(0))}</div><div class="grow"><div class="name">${esc(p.name)}</div><div class="sub">${esc(p.sku || '')} · ${esc(money(p.price))} · ${esc(String(p.stock))} in stock</div></div></button>`);
        group('Customers', custs, c => `<button class="row" style="width:100%;text-align:left" data-goto-customer="${attr(c.id)}"><div class="thumb" style="background:#efe6d8;color:#7a5c37">${esc(c.name.charAt(0))}</div><div class="grow"><div class="name">${esc(c.name)}</div><div class="sub">${esc(c.phone || '')}</div></div></button>`);
        group('Suppliers', sups, s => `<div class="row"><div class="thumb" style="background:var(--blue-bg);color:var(--blue)">${esc(s.name.charAt(0))}</div><div class="grow"><div class="name">${esc(s.name)}</div><div class="sub">${esc(s.phone || '')}</div></div></div>`);
        group('Sales', sales, s => `<button class="row" style="width:100%;text-align:left" data-sale="${attr(s.id)}"><div class="thumb" style="background:var(--green-50)">${icon('receipt', 13)}</div><div class="grow"><div class="name">${esc(s.no)}</div><div class="sub">${esc(fmtDT(s.at))} · ${esc(money(s.total))}</div></div></button>`);
        out.innerHTML = html || '<div class="empty">No matches.</div>';
      };
    }
  });
}

