/* ---------------------------------------------------------------- catalogue */
function nextNo(){
  DB.meta.seq = (DB.meta.seq || 1000) + 1;
  return (DB.config && DB.config.receiptPrefix || 'INV-') + '000' + DB.meta.seq;
}
function productById(id){ return DB.products.find(p => p.id === id); }
function categoryName(id){ const c = DB.categories.find(x => x.id === id); return c ? c.name : 'Uncategorised'; }
function findProductByCode(code){
  const c = String(code || '').trim();
  if (!c) return null;
  return DB.products.find(p => p.active !== false && (
    (p.barcode && p.barcode === c) || (p.sku && p.sku.toLowerCase() === c.toLowerCase()) ||
    (Array.isArray(p.extraBarcodes) && p.extraBarcodes.includes(c))
  )) || null;
}
function effectivePrice(p, customer){
  if (!customer) return p.price;
  if (customer.category === 'Wholesale' && p.wholesale) return p.wholesale;
  return p.price;
}
function productTaxRate(p){
  if (p.taxRate === null || p.taxRate === undefined || p.taxRate === '') return Number(DB.config.taxRate) || 0;
  return Number(p.taxRate) || 0;
}

/* ------------------------------------------------------------ stock moves */
function adjustStock(productId, delta, type, refId, reason, opts){
  const p = productById(productId);
  if (!p) return null;
  const o = opts || {};
  const track = o.force || (DB.config.trackStock && p.trackStock !== false);
  const prev = Number(p.stock) || 0;
  const next = track ? Math.round((prev + delta) * 1000) / 1000 : prev;
  p.stock = next;
  p.updatedAt = new Date().toISOString();
  if (track && delta !== 0){
    DB.movements.unshift({
      id:uid('mv'), productId, productName:p.name, sku:p.sku,
      prev, delta, next, type, refId:refId || '', user: (currentUser() || {}).name || 'Owner',
      at:new Date().toISOString(), reason:reason || ''
    });
    if (DB.movements.length > 6000) DB.movements.length = 6000;
  }
  return p;
}

/* ------------------------------------------------------------------- cart */
function newCart(){
  return {lines:[], customerId:'', customerName:'', orderDiscountType:'amount', orderDiscountValue:0, note:'', suspended:false, createdAt:new Date().toISOString()};
}
function getCart(){
  if (CART) return CART;
  try{
    const raw = localStorage.getItem(CART_KEY);
    CART = raw ? Object.assign(newCart(), JSON.parse(raw)) : newCart();
    if (!Array.isArray(CART.lines)) CART.lines = [];
  }catch(e){ CART = newCart(); }
  return CART;
}
function saveCart(){
  try{ localStorage.setItem(CART_KEY, JSON.stringify(getCart())); }catch(e){ /* non-fatal */ }
}
function cartCount(){ return sum(getCart().lines, l => l.qty); }
function lineTax(line, taxable){
  const mode = DB.config.taxMode;
  const r = (line.taxRate || 0) / 100;
  if (mode === 'none' || !r) return {tax:0, total:taxable};
  if (mode === 'inclusive'){
    const tax = taxable - taxable/(1+r);
    return {tax: Math.round(tax), total: taxable};
  }
  const tax = Math.round(taxable * r);
  return {tax, total: taxable + tax};
}
function computeCart(cart){
  const c = cart || getCart();
  const lines = [];
  let subtotal = 0, lineDisc = 0;
  c.lines.forEach(l => {
    const gross = Math.round(l.price * l.qty);
    const disc = Math.min(gross, Math.round(l.discount || 0));
    const net = gross - disc;
    subtotal += gross; lineDisc += disc;
    lines.push({...l, gross, disc, net});
  });
  const base = subtotal - lineDisc;
  const od = c.orderDiscountType === 'percent'
    ? Math.round(base * clamp(Number(c.orderDiscountValue) || 0, 0, 100) / 100)
    : Math.min(base, Math.round(Number(c.orderDiscountValue) || 0));
  let tax = 0, total = 0;
  const priced = lines.map(l => {
    const share = base > 0 ? l.net / base : 0;
    const alloc = Math.round(od * share);
    const taxable = Math.max(0, l.net - alloc);
    const t = lineTax(l, taxable);
    tax += t.tax; total += t.total;
    return {...l, orderDisc:alloc, taxable, tax:t.tax, total:t.total};
  });
  return {lines:priced, subtotal, lineDiscount:lineDisc, orderDiscount:od, discount:lineDisc + od, tax, total, qty: sum(priced, l => l.qty), cost: sum(priced, l => (l.cost || 0) * l.qty)};
}
function addToCart(product, qty, overridePrice){
  const c = getCart();
  const p = product || productById(product.id);
  if (!p) return {ok:false, msg:'Product not found.'};
  if (p.active === false) return {ok:false, msg: p.name + ' is archived.'};
  const track = DB.config.trackStock && p.trackStock !== false;
  const q = Math.max(0.001, Number(qty) || 1);
  const existing = c.lines.find(l => l.productId === p.id);
  const inCart = existing ? existing.qty : 0;
  if (track && !DB.config.negStock && inCart + q > (Number(p.stock) || 0)){
    return {ok:false, msg:`Only ${p.stock} ${p.unit || 'unit'} of ${p.name} available.`};
  }
  const price = overridePrice != null ? overridePrice : p.price;
  if (existing){
    existing.qty = Math.round((existing.qty + q) * 1000) / 1000;
  } else {
    c.lines.push({
      productId:p.id, name:p.name, sku:p.sku, qty:q, price,
      cost:p.cost, taxRate: productTaxRate(p), discount:0, unit:p.unit || 'pc'
    });
  }
  saveCart();
  return {ok:true};
}
function cartSetQty(productId, qty){
  const c = getCart();
  const line = c.lines.find(l => l.productId === productId);
  if (!line) return;
  const p = productById(productId);
  const track = p && DB.config.trackStock && p.trackStock !== false;
  let q = Math.round(Number(qty) * 1000) / 1000;
  if (!(q > 0)) q = 0;
  if (track && !DB.config.negStock && p && q > p.stock){
    toast(`Only ${p.stock} ${p.unit || 'unit'} in stock.`, 'warn');
    q = p.stock;
  }
  if (q === 0) c.lines = c.lines.filter(l => l.productId !== productId);
  else line.qty = q;
  saveCart();
}
function removeLine(productId){
  const c = getCart();
  c.lines = c.lines.filter(l => l.productId !== productId);
  saveCart();
}

/* -------------------------------------------------------------- checkout */
function completeSale(payments, opts){
  const o = opts || {};
  const c = getCart();
  const totals = computeCart(c);
  if (!totals.lines.length) return {ok:false, msg:'The cart is empty.'};
  const paid = sum(payments, p => p.amount);
  if (paid < totals.total) return {ok:false, msg:`Payment is short by ${money(totals.total - paid)}.`};
  if (paid > totals.total && !payments.some(p => p.method === 'Cash') && !o.allowOverpay){
    return {ok:false, msg:'Non-cash payments must match the total exactly.'};
  }
  // stock validation up front
  for (const l of totals.lines){
    const p = productById(l.productId);
    if (!p && !String(l.productId).startsWith('manual_')) return {ok:false, msg:`${l.name} no longer exists.`};
    if (p && DB.config.trackStock && p.trackStock !== false && !DB.config.negStock && l.qty > (Number(p.stock) || 0)){
      return {ok:false, msg:`${l.name} only has ${p.stock} in stock — adjust the quantity.`};
    }
  }
  const customer = c.customerId ? DB.customers.find(x => x.id === c.customerId) : null;
  if (customer && payments.some(p => p.method === 'Customer credit')){
    const credit = sum(payments.filter(p => p.method === 'Customer credit'), p => p.amount);
    if (customer.creditLimit && (customer.balance + credit) > customer.creditLimit){
      return {ok:false, msg:`Credit limit exceeded. Available credit: ${money(Math.max(0, customer.creditLimit - customer.balance))}.`};
    }
  }
  const shift = activeShift();
  const saleId = uid('sl');
  const sale = {
    id: saleId, no: nextNo(), kind:'sale', at: new Date().toISOString(),
    cashierId: (currentUser() || {}).id || '', cashierName: (currentUser() || {}).name || DB.config.owner,
    customerId: c.customerId, customerName: customer ? customer.name : 'Walk-in customer',
    items: totals.lines.map(l => ({
      productId:l.productId, name:l.name, sku:l.sku, qty:l.qty, price:l.price, cost:l.cost,
      taxRate:l.taxRate, discount:l.disc + l.orderDisc, lineTotal:l.total, tax:l.tax
    })),
    subtotal: totals.subtotal, discount: totals.discount, tax: totals.tax, total: totals.total,
    cost: totals.cost, payments: payments.map(p => ({method:p.method, amount:p.amount, ref:p.ref || ''})),
    change: Math.max(0, paid - totals.total), status:'completed', note: c.note || '',
    shiftId: shift ? shift.id : '', refunds:[]
  };

  // mutate stock (custom/manual lines have no product record)
  totals.lines.forEach(l => { if (productById(l.productId)) adjustStock(l.productId, -l.qty, 'sale', saleId, 'Sale ' + sale.no); });

  // customer updates
  if (customer){
    customer.totalSpent = (customer.totalSpent || 0) + totals.total;
    customer.lastPurchase = sale.at;
    const cfg = DB.config.loyalty || {};
    if (cfg.enabled){
      const earned = Math.floor(fromCents(totals.total) / (cfg.spendPer || 100)) * (cfg.earnPer || 1);
      if (earned > 0){
        customer.points = (customer.points || 0) + earned;
        sale.pointsEarned = earned;
      }
    }
    const credit = sum(payments.filter(p => p.method === 'Customer credit'), p => p.amount);
    if (credit) customer.balance = (customer.balance || 0) + credit;
  }
  DB.sales.unshift(sale);
  if (shift) shift.salesCount = (shift.salesCount || 0) + 1;

  DB.meta.seq = DB.meta.seq || 1000;
  audit('sale.completed', 'sale', saleId, {after:{no:sale.no, total:sale.total}, note:`${totals.qty} item(s)`});

  if (!saveDB()) return {ok:false, msg:'Storage failed — the sale was NOT saved. Your cart is intact.'};

  CART = newCart();
  saveCart();
  scanAlerts();
  return {ok:true, sale};
}

function returnSale(saleId, linesToReturn, method, reason, restock, opts){
  const sale = DB.sales.find(s => s.id === saleId && s.kind === 'sale');
  if (!sale) return {ok:false, msg:'Sale not found.'};
  const already = sale.refunds || [];
  const items = [];
  for (const r of linesToReturn){
    const sold = sale.items.find(i => i.productId === r.productId);
    if (!sold) continue;
    const prevReturned = sum(already, rf => sum(rf.items.filter(x => x.productId === r.productId), x => x.qty));
    const maxQty = sold.qty - prevReturned;
    const qty = Math.min(Number(r.qty) || 0, maxQty);
    if (qty > 0) items.push({productId:sold.productId, name:sold.name, qty, price:sold.price, cost:sold.cost, lineTotal: Math.round(sold.price * qty)});
  }
  if (!items.length) return {ok:false, msg:'No returnable quantity selected.'};
  const total = sum(items, i => i.lineTotal);
  const ret = {
    id: uid('sl'), no: nextNo(), kind:'return', parentId: sale.id, parentNo: sale.no,
    at: new Date().toISOString(), cashierId:(currentUser() || {}).id || '',
    cashierName:(currentUser() || {}).name || DB.config.owner,
    customerId: sale.customerId, customerName: sale.customerName,
    items, subtotal: total, discount:0, tax:0, total, cost: sum(items, i => i.cost * i.qty),
    payments:[{method, amount: total}], status:'completed', note: reason || 'Return',
    shiftId: sale.shiftId, restocked: !!restock
  };
  if (restock) items.forEach(i => adjustStock(i.productId, i.qty, 'return', ret.id, 'Return of ' + sale.no));
  const customer = sale.customerId ? DB.customers.find(c => c.id === sale.customerId) : null;
  if (customer){
    customer.totalSpent = Math.max(0, (customer.totalSpent || 0) - total);
    if (method === 'Customer credit') customer.balance = Math.max(0, (customer.balance || 0) - total);
  }
  DB.sales.push(ret);
  sale.refunds = (sale.refunds || []).concat([{id:ret.id, at:ret.at, total, items, method, reason}]);
  sale.status = sum(sale.refunds, r => sum(r.items, i => i.qty)) >= sum(sale.items, i => i.qty) ? 'refunded' : 'partially_refunded';
  audit('sale.returned', 'sale', ret.id, {after:{no:ret.no, total}, note:reason});
  if (!saveDB()) return {ok:false, msg:'Storage failed — the return was not saved.'};
  return {ok:true, ret};
}

/* ---------------------------------------------------------------- shifts */
function activeShift(){ return DB.shifts.find(s => !s.closedAt) || null; }
function shiftExpected(shift){
  const sales = DB.sales.filter(s => s.shiftId === shift.id);
  const cashIn = sum(sales.filter(s => s.kind === 'sale'), s => sum(s.payments.filter(p => p.method === 'Cash'), p => p.amount));
  const cashOut = sum(sales.filter(s => s.kind === 'return'), s => sum(s.payments.filter(p => p.method === 'Cash'), p => p.amount));
  const mov = sum(shift.cashMovements || [], m => m.type === 'in' ? m.amount : -m.amount);
  return shift.openingCash + cashIn - cashOut + mov;
}
function openShift(openingCash){
  const s = {
    id:uid('sh'), register:'Main register', openedAt:new Date().toISOString(),
    openedBy:(currentUser() || {}).name || DB.config.owner,
    openingCash:Number(openingCash) || 0, cashMovements:[], closedAt:null, salesCount:0
  };
  DB.shifts.unshift(s);
  audit('shift.opened', 'shift', s.id, {after:{openingCash:s.openingCash}});
  saveDB();
  return s;
}

/* --------------------------------------------------------------- reports */
function salesBetween(from, to){
  const a = from.getTime(), b = to.getTime();
  return DB.sales.filter(s => {
    const t = new Date(s.at).getTime();
    return t >= a && t <= b;
  });
}
function metrics(sales){
  const sells = sales.filter(s => s.kind === 'sale');
  const rets = sales.filter(s => s.kind === 'return');
  const grossSales = sum(sells, s => s.total);
  const refunds = sum(rets, s => s.total);
  const discounts = sum(sells, s => s.discount || 0);
  const tax = sum(sells, s => s.tax || 0);
  const cost = sum(sells, s => s.cost || 0) - sum(rets, s => s.cost || 0);
  const net = grossSales - refunds;
  const revenueExTax = net - tax;
  const profit = revenueExTax - cost;
  const cash = sum(sells, s => sum(s.payments.filter(p => p.method === 'Cash'), p => p.amount))
             - sum(rets, s => sum(s.payments.filter(p => p.method === 'Cash'), p => p.amount));
  const card = sum(sells, s => sum(s.payments.filter(p => p.method === 'Card'), p => p.amount));
  const other = sum(sells, s => sum(s.payments.filter(p => !['Cash','Card'].includes(p.method)), p => p.amount))
              - sum(rets, s => sum(s.payments.filter(p => !['Cash','Card'].includes(p.method)), p => p.amount));
  return {
    count: sells.length, grossSales, refunds, discounts, tax, cost, net, profit, cash, card, other,
    avg: sells.length ? Math.round(grossSales / sells.length) : 0,
    items: sum(sells, s => sum(s.items, i => i.qty)),
    returns: rets.length
  };
}
function expensesBetween(from, to){
  const a = from.getTime(), b = to.getTime();
  return DB.expenses.filter(e => { const t = new Date(e.at).getTime(); return t >= a && t <= b; });
}
function topProducts(sales, limit){
  const map = new Map();
  sales.filter(s => s.kind === 'sale').forEach(s => s.items.forEach(i => {
    const e = map.get(i.productId) || {id:i.productId, name:i.name, qty:0, revenue:0};
    e.qty += i.qty; e.revenue += i.lineTotal; map.set(i.productId, e);
  }));
  return Array.from(map.values()).sort((a,b) => b.revenue - a.revenue).slice(0, limit || 5);
}
function salesByMethod(sales){
  const map = new Map();
  sales.filter(s => s.kind === 'sale').forEach(s => s.payments.forEach(p => {
    map.set(p.method, (map.get(p.method) || 0) + p.amount);
  }));
  return Array.from(map.entries()).map(([method, amount]) => ({method, amount})).sort((a,b) => b.amount - a.amount);
}
function salesByCategory(sales){
  const map = new Map();
  sales.filter(s => s.kind === 'sale').forEach(s => s.items.forEach(i => {
    const p = productById(i.productId);
    const cat = p ? categoryName(p.category) : 'Other';
    map.set(cat, (map.get(cat) || 0) + i.lineTotal);
  }));
  return Array.from(map.entries()).map(([name, amount]) => ({name, amount})).sort((a,b) => b.amount - a.amount);
}
function inventoryValue(){
  return DB.products.filter(p => p.active !== false).reduce((a, p) => a + (Number(p.stock) || 0) * (p.cost || 0), 0);
}
function lowStock(){ return DB.products.filter(p => p.active !== false && (p.stock <= (p.minStock || 0))); }

/* ------------------------------------------------------- CSV import/export */
function download(filename, text, mime){
  const blob = new Blob([text], {type: mime || 'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1500);
  // also surface the export in the workspace files folder when unavailable
  return true;
}
function toCSV(rows, headers){
  const head = headers.map(h => csvCell(h.label)).join(',');
  const body = rows.map(r => headers.map(h => csvCell(typeof h.get === 'function' ? h.get(r) : r[h.key])).join(',')).join('\r\n');
  return '\ufeff' + head + '\r\n' + body;
}
function parseCSV(text){
  const rows = [];
  let row = [], field = '', q = false;
  const s = String(text).replace(/^\ufeff/, '');
  for (let i = 0; i < s.length; i++){
    const ch = s[i];
    if (q){
      if (ch === '"'){
        if (s[i+1] === '"'){ field += '"'; i++; }
        else q = false;
      } else field += ch;
    } else {
      if (ch === '"') q = true;
      else if (ch === ','){ row.push(field); field = ''; }
      else if (ch === '\n'){ row.push(field); rows.push(row); row = []; field = ''; }
      else if (ch === '\r'){ /* skip */ }
      else field += ch;
    }
  }
  if (field.length || row.length){ row.push(field); rows.push(row); }
  return rows.filter(r => r.some(c => String(c).trim() !== ''));
}

/* ---------------------------------------------------------------- backup */
function makeBackup(){
  const payload = {
    format:'unipos-backup', formatVersion:1, appVersion:APP_VERSION,
    schemaVersion:DB.meta.schemaVersion, exportedAt:new Date().toISOString(),
    business: DB.config ? DB.config.bizName : 'Unconfigured',
    counts:{
      products:DB.products.length, sales:DB.sales.length, customers:DB.customers.length,
      suppliers:DB.suppliers.length, purchases:DB.purchases.length, expenses:DB.expenses.length,
      movements:DB.movements.length, audit:DB.audit.length
    },
    data: JSON.parse(JSON.stringify(DB))
  };
  payload.checksum = simpleChecksum(JSON.stringify(payload.data));
  DB.meta.lastBackup = payload.exportedAt;
  saveDB();
  return payload;
}
function simpleChecksum(str){
  let h1 = 0x811c9dc5, h2 = 0x1000193;
  for (let i = 0; i < str.length; i++){
    h1 ^= str.charCodeAt(i); h1 = Math.imul(h1, 16777619) >>> 0;
    h2 = (Math.imul(h2 ^ str.charCodeAt(i), 2654435761)) >>> 0;
  }
  return h1.toString(16).padStart(8,'0') + h2.toString(16).padStart(8,'0');
}
function validateBackup(obj){
  const errors = [];
  if (!obj || typeof obj !== 'object') return {ok:false, errors:['File is not a JSON object.']};
  if (obj.format !== 'unipos-backup') errors.push('Not a UniPOS backup file (missing format marker).');
  if (!obj.data || typeof obj.data !== 'object') errors.push('Backup has no data payload.');
  if (obj.data && !obj.data.meta) errors.push('Backup payload is missing database metadata.');
  if (obj.formatVersion && obj.formatVersion > 1) errors.push('Backup was created by a newer format version.');
  if (obj.data && Array.isArray(obj.data.products) === false) errors.push('Backup products are not a list.');
  if (obj.checksum && obj.data){
    const c = simpleChecksum(JSON.stringify(obj.data));
    if (c !== obj.checksum) errors.push('Checksum mismatch — the file may be truncated or edited.');
  }
  return {ok: errors.length === 0, errors};
}

