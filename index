function emptyDB(){
  return {
    meta:{schemaVersion:SCHEMA_VERSION, appVersion:APP_VERSION, seq:1000, lastBackup:null, createdAt:new Date().toISOString()},
    config:null,
    products:[], categories:[], sales:[], customers:[], suppliers:[],
    purchases:[], movements:[], expenses:[], employees:[], shifts:[],
    notifications:[], audit:[]
  };
}
let storageOk = true, storageError = '';

function loadDB(){
  try{
    const raw = localStorage.getItem(DB_KEY);
    if (!raw){ DB = emptyDB(); return false; }
    const parsed = JSON.parse(raw);
    // guard against corrupted / unexpected shapes — never silently wipe data
    if (!parsed || typeof parsed !== 'object' || !parsed.meta){
      throw new Error('Database envelope is not recognised.');
    }
    DB = Object.assign(emptyDB(), parsed);
    ['products','categories','sales','customers','suppliers','purchases','movements','expenses','employees','shifts','notifications','audit']
      .forEach(k => { if (!Array.isArray(DB[k])) DB[k] = []; });
    if (!DB.meta.schemaVersion) DB.meta.schemaVersion = SCHEMA_VERSION;
    return !!DB.config;
  }catch(err){
    storageOk = false;
    storageError = err.message;
    DB = emptyDB();
    return false;
  }
}
function saveDB(){
  if (!DB) return false;
  try{
    const payload = JSON.stringify(DB);
    localStorage.setItem(DB_KEY, payload);
    return true;
  }catch(err){
    const quota = err && (err.name === 'QuotaExceededError' || err.name === 'NS_ERROR_DOM_QUOTA_REACHED' || err.code === 22);
    storageOk = false;
    storageError = quota ? 'Browser storage is full.' : (err.message || 'Storage write failed.');
    toast(quota
      ? 'Storage is full — export a backup, then remove old images or records.'
      : 'Could not save to browser storage: ' + storageError, 'err');
    return false;
  }
}
function storageBytes(){
  try{
    let t = 0;
    for (let i = 0; i < localStorage.length; i++){
      const k = localStorage.key(i);
      t += (k.length + (localStorage.getItem(k) || '').length) * 2;
    }
    return t;
  }catch(e){ return 0; }
}
function humanBytes(b){
  if (b < 1024) return b + ' B';
  if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
  return (b / 1048576).toFixed(2) + ' MB';
}

