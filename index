const CURRENCY_META = {
  LKR:{symbol:'Rs', dec:2}, USD:{symbol:'$', dec:2}, EUR:{symbol:'€', dec:2},
  GBP:{symbol:'£', dec:2}, INR:{symbol:'₹', dec:2}, AUD:{symbol:'A$', dec:2},
