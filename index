    userId: user ? user.id : 'system', userName: user ? user.name : 'System',
    action, entity: entity || '', entityId: entityId || '',
    before: o.before === undefined ? null : o.before,
    after: o.after === undefined ? null : o.after,
    note: o.note || '', result: o.result || 'success'
  });
  if (DB.audit.length > 4000) DB.audit.length = 4000;
}
