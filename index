function reportSales(){
  const [from, to] = rangeFor(UI.range);
  const sales = salesBetween(from, to);
  const m = metrics(sales);
  const days = [];
  const chartStart = startOfDay(new Date(Math.min(from.getTime(), to.getTime() - 13 * 86400000)));
  let cur = new Date(chartStart);
  while (cur <= to && days.length < 62){
    const dayEnd = endOfDay(cur);
    const dm = metrics(salesBetween(cur, dayEnd));
    days.push({label: cur.toLocaleDateString('en-GB', {day:'2-digit', month:'short'}), value: dm.net, count: dm.count});
    cur = new Date(cur.getTime() + 86400000);
  }
  const maxV = Math.max.apply(null, days.map(x => x.value).concat([1]));
  const byCat = salesByCategory(sales);
  const byMethod = salesByMethod(sales);
  const byCashier = {};
  sales.filter(s => s.kind === 'sale').forEach(s => {
    const k = s.cashierName || 'Unassigned';
    byCashier[k] = (byCashier[k] || 0) + s.total;
  });
  const top = topProducts(sales, 8);
  return `
  <div class="stat-grid">
    <div class="stat"><div class="lbl2">Gross sales</div><div class="val num">${esc(money(m.grossSales))}</div><div class="delta">${m.count} sales</div></div>
    <div class="stat"><div class="lbl2">Returns</div><div class="val num">${esc(money(m.refunds))}</div><div class="delta">${m.returns} return${m.returns === 1 ? '' : 's'}</div></div>
    <div class="stat"><div class="lbl2">Discounts given</div><div class="val num">${esc(money(m.discounts))}</div><div class="delta">line + order level</div></div>
    <div class="stat accent"><div class="lbl2">Net sales</div><div class="val num">${esc(money(m.net))}</div><div class="delta">gross − refunds</div></div>
  </div>
  <div class="card">
    <div class="card-head"><div class="card-icon">${icon('chart', 13)}</div><div class="grow"><h3>Net sales by day</h3><div class="muted">${esc(fmtDate(from))} → ${esc(fmtDate(to))}</div></div>
      <button class="btn sm" data-action="export-report-sales">${icon('download', 13)} CSV</button></div>
    ${days.length ? `<div class="bars" style="height:180px">${days.map((d, i) => `<div class="bar-col" title="${attr(d.label)}: ${attr(money(d.value))}">
      <div class="bar ${d.value === maxV && d.value > 0 ? 'hot' : (i % 2 ? 'alt' : '')}" style="height:${d.value > 0 ? Math.max(5, Math.round(d.value / maxV * 132)) : 3}px"></div>
      <span class="bar-x">${esc(d.label)}</span></div>`).join('')}</div>` : '<div class="empty">No sales in this range.</div>'}
  </div>
  <div class="split-2">
    <div class="card">
      <div class="card-head"><div class="card-icon">${icon('tag', 13)}</div><div class="grow"><h3>Sales by category</h3></div></div>
      ${byCat.length ? `<div class="table-wrap"><table class="tbl"><thead><tr><th>Category</th><th class="t-right">Revenue</th><th class="t-right">Share</th></tr></thead>
        <tbody>${byCat.map(c => `<tr><td>${esc(c.name)}</td><td class="t-num">${esc(money(c.amount))}</td><td class="t-num">${Math.round(c.amount / Math.max(1, sum(byCat, x => x.amount)) * 100)}%</td></tr>`).join('')}</tbody></table></div>` : '<div class="empty">No category sales.</div>'}
    </div>
    <div class="card">
      <div class="card-head"><div class="card-icon">${icon('coins', 13)}</div><div class="grow"><h3>Payment &amp; cashier</h3></div></div>
      <div class="tiny" style="margin-bottom:4px">Payment methods</div>
      ${byMethod.length ? byMethod.map(x => `<div class="kv"><span>${esc(x.method)}</span><b>${esc(money(x.amount))}</b></div>`).join('') : '<div class="tiny">None</div>'}
      <div class="tiny" style="margin:10px 0 4px">By cashier</div>
      ${Object.keys(byCashier).length ? Object.entries(byCashier).map(([k, v]) => `<div class="kv"><span>${esc(k)}</span><b>${esc(money(v))}</b></div>`).join('') : '<div class="tiny">None</div>'}
    </div>
  </div>
  <div class="card">
    <div class="card-head"><div class="card-icon">${icon('box', 13)}</div><div class="grow"><h3>Product performance</h3><div class="muted">Ranked by revenue</div></div>
      <button class="btn sm" data-action="export-report-products">${icon('download', 13)} CSV</button></div>
    ${top.length ? `<div class="table-wrap"><table class="tbl"><thead><tr><th>#</th><th>Product</th><th class="t-right">Units</th><th class="t-right">Revenue</th><th class="t-right">Avg price</th></tr></thead>
      <tbody>${top.map((p, i) => `<tr><td>${i + 1}</td><td class="t-strong">${esc(p.name)}</td><td class="t-num">${p.qty}</td><td class="t-num">${esc(money(p.revenue))}</td><td class="t-num">${esc(money(Math.round(p.revenue / Math.max(1, p.qty))))}</td></tr>`).join('')}</tbody></table></div>` : '<div class="empty">No product sales in this range.</div>'}
  </div>`;
}

