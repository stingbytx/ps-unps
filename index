/* ---------------------------------------------------------- notifications */
function notify(type, title, body, priority, ref){
  const n = {
    id: uid('nt'), type, title, body: body || '', priority: priority || 'normal',
    at: new Date().toISOString(), read: false, ref: ref || ''
  };
  DB.notifications.unshift(n);
  if (DB.notifications.length > 300) DB.notifications.length = 300;
  // dedupe low-stock style alerts per entity per day
  const dot = $('#notifDot');
  if (dot) dot.hidden = false;
  return n;
}
function refreshNotifDot(){
  const unread = DB.notifications.filter(n => !n.read).length;
  const dot = $('#notifDot');
  if (dot) dot.hidden = unread === 0;
  const b = $('#btnNotif');
  if (b) b.title = unread ? `${unread} unread notification${unread === 1 ? '' : 's'}` : 'Notifications';
}
function scanAlerts(){
  if (!DB.config) return;
  const cfg = DB.config;
  if (!cfg.alerts || cfg.alerts.lowStock !== false){
    DB.products.filter(p => p.active && p.trackStock !== false).forEach(p => {
      const low = p.stock <= (p.minStock || 0) && p.stock > 0;
      const out = p.stock <= 0;
      if (!low && !out) return;
      const key = out ? 'out:' : 'low:';
      const exists = DB.notifications.some(n => n.ref === key + p.id && isoDay(n.at) === isoDay(new Date()));
      if (!exists){
        notify('stock', out ? 'Out of stock' : 'Low stock',
          `${p.name} is at ${p.stock} ${p.unit || 'unit'}${Math.abs(p.stock) === 1 ? '' : 's'} (min ${p.minStock || 0}).`,
          out ? 'high' : 'normal', key + p.id);
      }
    });
  }
  if (cfg.expiryAlerts !== false){
    DB.products.filter(p => p.expiry && p.active).forEach(p => {
      const days = Math.ceil((new Date(p.expiry) - Date.now()) / 86400000);
      if (days <= 30){
        const key = 'exp:' + p.id;
        const exists = DB.notifications.some(n => n.ref === key && isoDay(n.at) === isoDay(new Date()));
        if (!exists) notify('expiry', days < 0 ? 'Product expired' : 'Expiry approaching',
          `${p.name} ${days < 0 ? 'expired ' + Math.abs(days) + ' days ago' : 'expires in ' + days + ' days'}.`,
          days < 0 ? 'high' : 'normal', key);
      }
    });
  }
}

/* ----------------------------------------------------------------- toasts */
function toast(msg, kind, ms){
  const wrap = $('#toasts');
  if (!wrap) return;
  const el = document.createElement('div');
  el.className = 'toast' + (kind === 'err' ? ' err' : kind === 'warn' ? ' warn' : '');
  el.innerHTML = icon(kind === 'err' || kind === 'warn' ? 'alert' : 'check', 14) + `<span>${esc(msg)}</span>`;
  wrap.appendChild(el);
  setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .2s'; setTimeout(() => el.remove(), 220); }, ms || 3200);
}

/* ------------------------------------------------------------------ modal */
let modalStack = [];
function openModal(opts){
  const m = $('#modal');
  $('#modalTitle').textContent = opts.title || '';
  $('#modalBody').innerHTML = opts.body || '';
  const foot = $('#modalFoot');
  foot.innerHTML = '';
  (opts.actions || [{label:'Close', kind:'ghost'}]).forEach(a => {
    const b = document.createElement('button');
    b.className = 'btn ' + (a.kind || '');
    b.textContent = a.label;
    b.onclick = () => {
      if (a.onClick && a.onClick() === false) return;
      if (a.keepOpen !== true) closeModal();
    };
    foot.appendChild(b);
  });
  m.className = 'modal' + (opts.size === 'wide' ? ' wide' : opts.size === 'narrow' ? ' narrow' : '');
  $('#overlay').classList.add('on');
  if (opts.onMount) opts.onMount($('#modalBody'));
  const first = $('#modalBody').querySelector('input,select,textarea');
  if (first) setTimeout(() => first.focus(), 40);
  modalStack.push(opts);
}
function closeModal(){
  $('#overlay').classList.remove('on');
  modalStack.pop();
}
function confirmDialog(title, message, onYes, opts){
  const o = opts || {};
  openModal({
    title, size:'narrow',
    body:`<p style="font-size:13px;color:var(--text-2);line-height:1.6">${esc(message)}</p>`,
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:o.yes || 'Confirm', kind:o.danger ? 'danger' : 'primary', onClick:onYes}
    ]
  });
}
function promptDialog(title, label, onOk, opts){
  const o = opts || {};
  openModal({
    title, size:'narrow',
    body:`<div class="field"><label>${esc(label)}</label><input type="text" id="pdInput" value="${attr(o.value || '')}" placeholder="${attr(o.placeholder || '')}"></div>`,
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:o.yes || 'Save', kind:'primary', onClick:() => {
        const v = $('#pdInput').value.trim();
        if (!v){ toast('A value is required.', 'err'); return false; }
        onOk(v);
      }}
    ]
  });
}

