    const code = e.target.value.trim();
    if (!code) return;
    const p = findProductByCode(code);
    if (p){
      const res = addToCart(p, 1);
      if (!res.ok){ toast(res.msg, 'err'); return; }
      e.target.value = ''; UI.posQuery = '';
      renderProductGrid(); renderCartPanel();
      toast(p.name + ' added');
    } else {
      const exact = posProducts();
      if (exact.length === 1){
        const res = addToCart(exact[0], 1);
        if (!res.ok){ toast(res.msg, 'err'); return; }
        e.target.value = ''; UI.posQuery = '';
        renderProductGrid(); renderCartPanel();
      } else {
        toast('No product matched “' + code + '”.', 'warn');
      }
    }
  }
  if (['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)) return;
  if (e.key === 'F2'){ e.preventDefault(); navigate('pos'); }
  if (e.key === 'F4'){ e.preventDefault(); if (UI.view !== 'pos') navigate('pos'); openCheckout(); }
  if (e.key === 'F8'){ e.preventDefault(); ACTIONS['hold-sale'](); }
  if (e.key === '/'){ e.preventDefault(); const el = $('#posSearch') || $('#globalInput'); if (el) el.focus(); }
  if (e.key === 'Escape'){ closeModal(); }
  if (e.key === '?'){ e.preventDefault(); openShortcuts(); }
});

