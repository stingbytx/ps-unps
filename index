function openAdjustStock(productId){
  const options = DB.products.filter(p => p.active !== false).map(p => ({value:p.id, label:`${p.name} (${p.stock})`}));
  formModal({
    title:'Stock adjustment',
    fields:[
      {key:'productId', label:'Product', type:'select', options, value: productId || (options[0] && options[0].value), required:true, full:true},
      {key:'dir', label:'Direction', type:'select', options:[{value:'in', label:'Add stock (received, found, returned)'}, {value:'out', label:'Remove stock (damaged, lost, expired)'}], full:true},
      {key:'qty', label:'Quantity', type:'number', min:0, step:'0.001', value:1, required:true},
      {key:'type', label:'Reason type', type:'select', options:['adjustment','damaged','expired','lost','opening','stock count']},
      {key:'reason', label:'Note', full:true, placeholder:'What happened?'}
    ],
    submit:'Apply adjustment',
    onSubmit(v){
      const p = productById(v.productId);
      if (!p) return false;
      const delta = (v.dir === 'out' ? -1 : 1) * Math.abs(Number(v.qty) || 0);
      if (!delta){ toast('Quantity must be greater than zero.', 'err'); return false; }
      adjustStock(p.id, delta, v.type, '', v.reason);
      audit('stock.adjusted', 'product', p.id, {note:`${delta} (${v.type}) ${v.reason || ''}`, after:{stock:p.stock}});
      saveDB(); render(); toast('Stock updated · ' + p.name + ' now ' + p.stock); return true;
    }
  });
}

function openReceiveStock(productId){
  const p = productById(productId);
  if (!p) return;
  formModal({
    title:'Receive stock', size:'',
    fields:[
      {key:'static', type:'static', html:`<div class="notice info">${icon('info', 13)}<span>Quick receipt without a purchase order. To track supplier invoices, create a purchase instead.</span></div>`},
      {key:'qty', label:`Quantity received (${p.unit || 'pc'})`, type:'number', min:0, value: Math.max(1, (p.minStock || 0) * 2), required:true},
      {key:'cost', label:'Unit cost', type:'money', value: fromCents(p.cost || 0)},
      {key:'supplier', label:'Supplier note', full:true, value:p.supplier || ''}
    ],
    submit:'Receive',
    onSubmit(v){
      if (v.qty <= 0) return false;
      adjustStock(p.id, v.qty, 'purchase', '', 'Quick stock receive');
      if (v.cost) p.cost = v.cost;
      audit('stock.received', 'product', p.id, {after:{qty:v.qty, cost:v.cost}});
      saveDB(); render(); toast(`Received ${v.qty} × ${p.name}`); return true;
    }
  });
}

