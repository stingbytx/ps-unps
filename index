let wizard = {step:1, type:'retail'};

function initWizard(){
  const grid = $('#wTypes');
  grid.innerHTML = Object.entries(PROFILES).map(([k, v]) =>
    `<button type="button" class="type-opt ${wizard.type === k ? 'on' : ''}" data-type="${k}">
      <span class="em">${v.em}</span><span>${esc(v.label)}</span></button>`).join('');
  grid.onclick = e => {
    const b = e.target.closest('[data-type]');
    if (!b) return;
    wizard.type = b.dataset.type;
    $$('.type-opt', grid).forEach(x => x.classList.toggle('on', x.dataset.type === wizard.type));
    $('#wTypeHint').textContent = PROFILES[wizard.type].label + ' — modules and terminology will be configured for this business type.';
  };
  $('#wStep1').onsubmit = e => {
    e.preventDefault();
    if (!$('#wName').value.trim()){ toast('Enter a business name.', 'err'); $('#wName').focus(); return; }
    if (!$('#wOwner').value.trim()){ toast('Enter the owner name.', 'err'); $('#wOwner').focus(); return; }
    goWizard(2);
  };
  $('#wStep2').onsubmit = e => {
    e.preventDefault();
    const email = $('#wEmail').value.trim();
    if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ toast('That email address looks wrong.', 'err'); return; }
    goWizard(3);
  };
  $$('[data-wback]').forEach(b => b.onclick = () => goWizard(Number(b.dataset.wback)));
  $('#wStep3').onsubmit = e => { e.preventDefault(); finishSetup(); };
  $('#wDisclaimer').innerHTML = icon('info', 13) + '<span>UniPOS stores everything in this browser only. No account, server or internet connection is required after the file is saved.</span>';
}

function goWizard(n){
  wizard.step = n;
  $$('.wizard-step').forEach((el, i) => el.classList.toggle('on', i + 1 === n));
  $$('.steps i').forEach((el, i) => el.classList.toggle('on', i < n));
  $('#setup').scrollTop = 0;
}

async function finishSetup(){
  const pin = $('#wPin').value.trim();
  if (pin && !/^\d{4,8}$/.test(pin)){ toast('PIN must be 4–8 digits.', 'err'); return; }
  const profile = PROFILES[wizard.type];
  const cfg = defaultConfig();
  Object.assign(cfg, {
    bizName: $('#wName').value.trim(),
    bizType: wizard.type,
    owner: $('#wOwner').value.trim(),
    country: $('#wCountry').value,
    currency: $('#wCurrency').value,
    tz: $('#wTz').value,
    taxMode: $('#wTaxMode').value,
    taxRate: Number($('#wTaxRate').value) || 0,
    phone: $('#wPhone').value.trim(),
    email: $('#wEmail').value.trim(),
    address: $('#wAddress').value.trim(),
    footer: $('#wFooter').value.trim(),
    paper: $('#wPaper').value,
    trackStock: $('#wTrack').value === '1',
    negStock: $('#wNeg').value === '1',
    openingCash: Number($('#wCash').value) || 0,
    modules: Object.assign({}, profile.modules),
    pinHash: pin ? await hashPin(pin) : ''
  });
  DB.config = cfg;
  DB.meta.createdAt = new Date().toISOString();
  DB.employees = [{
    id:uid('em'), name:cfg.owner, role:'Owner', phone:cfg.phone,
    pinHash:cfg.pinHash || '', active:true, createdAt:new Date().toISOString()
  }];
  if ($('#wDemo').checked){
    seedDemo();
  } else {
    DB.shifts = [{
      id:uid('sh'), register:'Main register', openedAt:new Date().toISOString(),
      openedBy:cfg.owner, openingCash: toCents(cfg.openingCash || 0), cashMovements:[], closedAt:null
    }];
    DB.categories = ['General','Beverages','Food','Services'].map(n => ({id:uid('cat'), name:n}));
  }
  setUser(DB.employees[0]);
  audit('business.created', 'config', 'config', {after:{bizName:cfg.bizName, type:wizard.type}});
  if (!saveDB()){
    toast('Could not save — browser storage is unavailable. Try a normal (non-private) window.', 'err', 7000);
    return;
  }
  CART = newCart(); saveCart();
  $('#setup').classList.remove('on');
  scanAlerts();
  navigate('dashboard');
  toast('Welcome to UniPOS, ' + cfg.bizName.split(' ')[0] + '!');
}

/* --------------------------------- lock --------------------------------- */
function lockSession(){
  if (!DB.config || (!DB.config.pinHash && !DB.employees.some(e => e.pinHash))){ toast('Set an admin PIN in Settings first.', 'warn'); return; }
  UI.locked = true;
  $('#lockOverlay').classList.add('on');
  setTimeout(() => $('#lockPin').focus(), 80);
}
async function tryUnlock(){
  const val = $('#lockPin').value.trim();
  if (!val) return;
  const hashes = [DB.config.pinHash].concat(DB.employees.map(e => e.pinHash)).filter(Boolean);
  const h = await hashPin(val);
  if (hashes.includes(h)){
    UI.locked = false; UI.lastActivity = Date.now();
    $('#lockOverlay').classList.remove('on');
    $('#lockPin').value = '';
    $('#lockMsg').textContent = 'Locked after inactivity.';
    toast('Session unlocked.');
  } else {
    $('#lockMsg').textContent = 'Incorrect PIN — try again.';
    $('#lockPin').value = '';
  }
}

