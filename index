let scanBuf = '', scanTimer = null;
document.addEventListener('keydown', e => {
  if (!DB.config || UI.view !== 'pos') return;
  if (['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)) return;
  if (e.key === 'Enter'){
    if (scanBuf.length >= 4){
      const p = findProductByCode(scanBuf);
      if (p){ addProductToCart(p.id, 1); toast(p.name + ' added'); }
      else toast('Unknown barcode: ' + scanBuf, 'warn');
      e.preventDefault();
    }
    scanBuf = '';
    clearTimeout(scanTimer);
    return;
  }
  if (e.key.length === 1){
    scanBuf += e.key;
    clearTimeout(scanTimer);
    scanTimer = setTimeout(() => { scanBuf = ''; }, 120);
  }
});

