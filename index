RENDERERS.expenses = function(){
  const [from, to] = rangeFor(UI.range);
  const list = DB.expenses.slice().sort((a,b) => new Date(b.at) - new Date(a.at));
  const inRange = list.filter(e => new Date(e.at) >= from && new Date(e.at) <= to);
  const byCat = {};
