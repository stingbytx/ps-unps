function productForm(product){
  const p = product || {};
  formModal({
    title: product ? 'Edit product' : 'New product',
    fields:[
      {key:'name', label:'Product name', required:true, placeholder:'e.g. Ceylon Black Tea 100g'},
      {key:'category', label:'Category', type:'select', options:[{value:'', label:'Uncategorised'}].concat(DB.categories.map(c => ({value:c.id, label:c.name})))},
      {key:'sku', label:'SKU', placeholder:'TEA-001'},
      {key:'barcode', label:'Barcode', placeholder:'Scan or type'},
      {key:'cost', label:'Purchase cost', type:'money', value: fromCents(p.cost || 0)},
      {key:'price', label:'Selling price', type:'money', required:true, value: fromCents(p.price || 0)},
      {key:'wholesale', label:'Wholesale price', type:'money', value: fromCents(p.wholesale || p.price || 0)},
      {key:'taxRate', label:'Tax rate %', type:'number', value: p.taxRate != null ? p.taxRate : '', hint:'Blank = business default'},
      {key:'stock', label:'Stock on hand', type:'number', value: p.stock != null ? p.stock : 0},
      {key:'minStock', label:'Minimum stock', type:'number', value: p.minStock != null ? p.minStock : 5},
      {key:'unit', label:'Unit', type:'select', options:['pc','kg','g','L','ml','box','pack','hour'], value: p.unit || 'pc'},
      {key:'expiry', label:'Expiry date', type:'date', value: p.expiry || ''},
      {key:'brand', label:'Brand', value: p.brand || ''},
      {key:'supplier', label:'Supplier', value: p.supplier || ''},
      {key:'image', label:'Image URL', value: p.image || '', hint:'Optional · keep small (under ~200 KB)'},
      {key:'trackStock', label:'Track stock for this product', type:'checkbox', value: p.trackStock !== false},
      {key:'description', label:'Description', type:'textarea', rows:2, value: p.description || ''},
    ],
    values:p,
    onSubmit(v){
      if (v.sku){
        const dup = DB.products.find(x => x.id !== p.id && x.sku && x.sku.toLowerCase() === v.sku.toLowerCase());
        if (dup){ toast('SKU already used by ' + dup.name + '.', 'err'); return false; }
      }
      if (v.barcode){
        const dup = DB.products.find(x => x.id !== p.id && x.barcode === v.barcode);
        if (dup){ toast('Barcode already used by ' + dup.name + '.', 'err'); return false; }
      }
      if (!v.price || v.price <= 0){ toast('Selling price must be greater than zero.', 'err'); return false; }
      if (product){
        const before = {price:p.price, cost:p.cost, stock:p.stock};
        Object.assign(p, v, {updatedAt:new Date().toISOString()});
        if (Number(before.stock) !== Number(v.stock)) adjustStock(p.id, Number(v.stock) - Number(before.stock), 'adjustment', '', 'Edited product quantity');
        audit('product.updated', 'product', p.id, {before, after:{price:v.price, cost:v.cost, stock:v.stock}});
      } else {
        const np = Object.assign({
          id:uid('pr'), active:true, variants:[], maxStock:0, createdAt:new Date().toISOString()
        }, v);
        DB.products.push(np);
        if (np.stock) adjustStock(np.id, np.stock, 'opening', '', 'Opening stock');
        audit('product.created', 'product', np.id, {after:{name:np.name, price:np.price}});
      }
      saveDB(); render(); toast('Product saved.'); return true;
    }
  });
}

