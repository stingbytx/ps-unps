function addProductToCart(productId, qty){
  const p = productById(productId);
  if (!p) return;
  const res = addToCart(p, qty || 1);
  if (!res.ok){ toast(res.msg, 'err'); return; }
  renderCartPanel();
  const btn = $('[data-action="checkout"]');
  if (btn) btn.disabled = false;
  $$('[data-action="checkout"]').forEach(b => b.disabled = false);
}

/* ------------------------------------------------------------- checkout */
function openCheckout(){
  const t = computeCart(getCart());
  if (!t.lines.length){ toast('Add at least one item first.', 'warn'); return; }
  const customer = getCart().customerId ? DB.customers.find(x => x.id === getCart().customerId) : null;
  const methods = PAY_METHODS;
  const rowHTML = (method, amount, i) => `<div class="pay-row" data-row="${i}" style="display:grid;grid-template-columns:1fr 120px 30px;gap:7px;align-items:center">
    <select class="pay-method" style="height:34px;font-size:12px">${methods.map(m => `<option ${m === method ? 'selected' : ''}>${m}</option>`).join('')}</select>
    <input class="pay-amt" type="number" min="0" step="0.01" value="${amount}" style="height:34px;text-align:right;font-variant-numeric:tabular-nums">
    <button class="mini-x pay-del" title="Remove">${icon('x', 11)}</button>
  </div>`;
  openModal({
    title:'Take payment',
    body:`
      <div style="text-align:center;padding:6px 0 10px">
        <div class="tiny">Amount due</div>
        <div class="big-num num" style="font-size:38px">${esc(money(t.total))}</div>
        <div class="tiny">${t.qty} item(s) · tax ${esc(money(t.tax))}${customer ? ' · ' + esc(customer.name) : ''}</div>
      </div>
      <div id="payRows" style="display:flex;flex-direction:column;gap:7px">
        ${rowHTML('Cash', fromCents(t.total), 0)}
      </div>
      <div style="display:flex;gap:7px;flex-wrap:wrap">
        <button type="button" class="btn sm" id="addPay">${icon('plus', 12)} Split payment</button>
        <button type="button" class="btn sm" data-tender="exact">Exact</button>
        <button type="button" class="btn sm" data-tender="500">+ 500</button>
        <button type="button" class="btn sm" data-tender="1000">+ 1,000</button>
      </div>
      <div class="notice info" id="payHint">${icon('info', 13)}<span>Split payments are supported. Cash overpayment is returned as change.</span></div>
      ${customer && customer.creditLimit ? `<div class="tiny">Credit available: ${esc(money(Math.max(0, customer.creditLimit - (customer.balance || 0))))}</div>` : ''}
    `,
    size:'narrow',
    onMount(body){
      const rows = $('#payRows', body);
      let seq = 1;
      const update = () => {
        const paid = sum($$('.pay-amt', rows), i => toCents(i.value));
        const diff = paid - t.total;
        const hint = $('#payHint', body);
        if (diff >= 0){
          hint.className = 'notice info';
          hint.innerHTML = icon('check', 13) + `<span>${diff > 0 ? 'Change due: <b>' + esc(money(diff)) + '</b>' : 'Payment covers the total exactly.'}</span>`;
        } else {
          hint.className = 'notice';
          hint.innerHTML = icon('alert', 13) + `<span>Still to collect: <b>${esc(money(-diff))}</b></span>`;
        }
      };
      rows.addEventListener('click', e => {
        const del = e.target.closest('.pay-del');
        if (del){
          if ($$('.pay-row', rows).length > 1){ del.closest('.pay-row').remove(); update(); }
        }
      });
      rows.addEventListener('input', update);
      $('#addPay', body).onclick = () => {
        rows.insertAdjacentHTML('beforeend', rowHTML('Card', '0', seq++));
        update();
      };
      $$('[data-tender]', body).forEach(b => b.onclick = () => {
        const kind = b.dataset.tender;
        const first = $('.pay-amt', rows);
        if (kind === 'exact') first.value = fromCents(t.total).toFixed(2);
        else first.value = (Number(first.value || 0) + Number(kind)).toFixed(2);
        update();
      });
      update();
    },
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:'Complete sale', kind:'primary', keepOpen:true, onClick(){
        const rows = $$('.pay-row');
        const payments = [];
        rows.forEach(r => {
          const method = $('.pay-method', r).value;
          const amount = toCents($('.pay-amt', r).value);
          if (amount > 0) payments.push({method, amount});
        });
        if (!payments.length){ toast('Enter a payment amount.', 'err'); return false; }
        const res = completeSale(payments);
        if (!res.ok){ toast(res.msg, 'err', 5000); return false; }
        closeModal();
        showSaleComplete(res.sale);
        if (UI.view === 'pos'){ renderCartPanel(); renderProductGrid(); render(); }
        else render();
        return false;
      }}
    ]
  });
}

