  booted = true;
  try{ UI.navOpen = localStorage.getItem('unipos_nav_open_v1') === '1'; }catch(e){ UI.navOpen = false; }
  const configured = loadDB();
  loadHeld();
  if (!storageOk && !configured){
    toast('Browser storage is unavailable — data cannot be saved in this window.', 'err', 8000);
  }
  if (!configured){
    $('#setup').classList.add('on');
    initWizard();
    renderShell();
    return;
  }
  // migrate / normalise config
  DB.config = Object.assign(defaultConfig(), DB.config);
  DB.config.modules = Object.assign(defaultConfig().modules, DB.config.modules || {});
  DB.config.loyalty = Object.assign(defaultConfig().loyalty, DB.config.loyalty || {});
  DB.employees = DB.employees || [];
  if (!DB.employees.length){
    DB.employees.push({id:uid('em'), name:DB.config.owner || 'Owner', role:'Owner', pinHash:DB.config.pinHash || '', active:true, createdAt:new Date().toISOString()});
  }
  const u = currentUser();
  if (!u && DB.employees[0]) setUser(DB.employees[0]);
  $('#setup').classList.remove('on');
  const hashView = location.hash.slice(1);
  if (hashView && RENDERERS[hashView]) UI.view = hashView;
  render();
  scanAlerts();
  refreshNotifDot();
  startAutoLock();
  if (!$('#lockBtn').dataset.bound){
    $('#lockBtn').dataset.bound = '1';
    $('#lockBtn').onclick = tryUnlock;
  }
}

document.addEventListener('DOMContentLoaded', boot);
if (document.readyState !== 'loading') boot();
</script>
</body>
</html>
