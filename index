}

function reportFinancial(){
  const [from, to] = (UI.finFrom && UI.finTo)
    ? [new Date(UI.finFrom + 'T00:00:00'), new Date(UI.finTo + 'T23:59:59')]
    : rangeFor(UI.range);
  const sales = salesBetween(from, to);
  const m = metrics(sales);
  const exp = expensesBetween(from, to);
  const expTotal = sum(exp, e => e.amount);
  const opProfit = m.profit - expTotal;
  const cogs = m.cost;
  const rows = [
    ['Gross sales (incl. tax)', m.grossSales, ''],
    ['Discounts given', -m.discounts, 'deduction'],
    ['Returns & refunds', -m.refunds, 'deduction'],
    ['Net sales', m.net, 'total'],
    ['Tax collected (remitted)', -m.tax, 'deduction'],
    ['Revenue excluding tax', m.net - m.tax, 'subtotal'],
    ['Cost of goods sold', -cogs, 'deduction'],
    ['Gross profit', m.profit, 'total'],
    ['Operating expenses', -expTotal, 'deduction'],
    ['Estimated operating profit', opProfit, 'total']
  ];
  const byCat = {};
  exp.forEach(e => { byCat[e.category] = (byCat[e.category] || 0) + e.amount; });
  return `
  <div class="card">
    <div class="card-head"><div class="card-icon">${icon('chart', 13)}</div><div class="grow"><h3>Profit &amp; loss</h3><div class="muted">${esc(fmtDate(from))} → ${esc(fmtDate(to))}</div></div>
      <button class="btn sm" data-action="export-report-financial">${icon('download', 13)} CSV</button></div>
    <div class="table-wrap"><table class="tbl"><tbody>
      ${rows.map(r => `<tr style="${r[2] === 'total' ? 'background:var(--green-50);font-weight:700' : r[2] === 'subtotal' ? 'font-weight:600' : ''}">
        <td>${esc(r[0])}</td><td class="t-num" style="color:${r[1] < 0 ? 'var(--text-2)' : 'inherit'}">${r[1] < 0 ? '−' : ''}${esc(money(Math.abs(r[1])))}</td></tr>`).join('')}
    </tbody></table></div>
    <div class="notice info" style="margin-top:12px">${icon('info', 13)}<span>Gross profit uses the cost recorded on each sale line. If a historical line has no cost, profit is incomplete for that line. Operating profit is an estimate and excludes depreciation, loan repayments and owner drawings.</span></div>
  </div>
  <div class="split-2">
    <div class="card">
      <div class="card-head"><div class="card-icon">${icon('banknote', 13)}</div><div class="grow"><h3>Cash flow</h3></div></div>
      <div class="kv"><span>Cash received from sales</span><b>${esc(money(m.cash))}</b></div>
      <div class="kv"><span>Card settlements</span><b>${esc(money(m.card))}</b></div>
      <div class="kv"><span>Other / digital</span><b>${esc(money(m.other))}</b></div>
      <div class="kv"><span>Customer credit issued</span><b>${esc(money(sum(sales.filter(s => s.kind === 'sale'), s => sum(s.payments.filter(p => p.method === 'Customer credit'), p => p.amount))))}</b></div>
      <div class="kv"><span>Expenses paid</span><b>−${esc(money(expTotal))}</b></div>
      <div class="kv"><span>Net cash movement</span><b>${esc(money(m.cash + m.card + m.other - expTotal))}</b></div>
    </div>
