/* -------------------------------------------------------------------- dates */
function d(v){ return new Date(v); }
function pad2(n){ return String(n).padStart(2, '0'); }
function fmtDate(v){
  const x = v instanceof Date ? v : new Date(v);
  if (isNaN(x)) return '—';
  const cfg = (DB && DB.config) || {};
  if (cfg.dateFormat === 'DD/MM/YYYY') return `${pad2(x.getDate())}/${pad2(x.getMonth()+1)}/${x.getFullYear()}`;
  if (cfg.dateFormat === 'YYYY-MM-DD') return `${x.getFullYear()}-${pad2(x.getMonth()+1)}-${pad2(x.getDate())}`;
  return x.toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'});
}
function fmtTime(v){
  const x = v instanceof Date ? v : new Date(v);
  if (isNaN(x)) return '—';
  const h = x.getHours(), m = x.getMinutes();
  const h12 = h % 12 === 0 ? 12 : h % 12;
  const suffix = h < 12 ? 'AM' : 'PM';
  return `${pad2(h12)}:${pad2(m)} ${suffix}`;
}
function fmtDT(v){ return `${fmtDate(v)} · ${fmtTime(v)}`; }
function startOfDay(dt){ const x = new Date(dt); x.setHours(0,0,0,0); return x; }
function endOfDay(dt){ const x = new Date(dt); x.setHours(23,59,59,999); return x; }
function isoDay(dt){ const x = new Date(dt); return `${x.getFullYear()}-${pad2(x.getMonth()+1)}-${pad2(x.getDate())}`; }
function daysAgo(n){ const x = new Date(); x.setDate(x.getDate() - n); return x; }
function rangeFor(preset){
  const now = new Date();
  switch(preset){
    case 'yesterday': { const y = daysAgo(1); return [startOfDay(y), endOfDay(y)]; }
    case '7d': return [startOfDay(daysAgo(6)), endOfDay(now)];
    case '30d': return [startOfDay(daysAgo(29)), endOfDay(now)];
    case 'month': return [new Date(now.getFullYear(), now.getMonth(), 1), endOfDay(now)];
    case 'lastmonth': {
      const s = new Date(now.getFullYear(), now.getMonth()-1, 1);
      const e = new Date(now.getFullYear(), now.getMonth(), 0, 23, 59, 59, 999);
      return [s, e];
    }
    case 'year': return [new Date(now.getFullYear(), 0, 1), endOfDay(now)];
    default: return [startOfDay(now), endOfDay(now)];
  }
}
function relTime(v){
  const diff = Date.now() - new Date(v).getTime();
  const mins = Math.round(diff / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return mins + 'm ago';
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return hrs + 'h ago';
  const days = Math.round(hrs / 24);
  if (days < 30) return days + 'd ago';
  return fmtDate(v);
}

/* ---------------------------------------------------------------- hashing */
/* Client-only PIN protection. This is an operational lock, not real security:
   anyone with access to this device can read or edit browser storage. */
async function hashPin(pin){
  const raw = 'unipos::' + pin;
  if (window.crypto && crypto.subtle){
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }
  // deterministic fallback for non-secure contexts
  let h1 = 0x811c9dc5, h2 = 0x1000193;
  for (let i = 0; i < raw.length; i++){
    h1 ^= raw.charCodeAt(i); h1 = Math.imul(h1, 16777619) >>> 0;
    h2 = (Math.imul(h2 ^ raw.charCodeAt(i), 2654435761)) >>> 0;
  }
  return ('00000000' + h1.toString(16)).slice(-8) + ('00000000' + h2.toString(16)).slice(-8);
}

