      {key:'active', label:'Active employee', type:'checkbox', value: e.active !== false}
    ],
    onSubmit(v){
      const pin = v.pin;
      if (pin && !/^\d{4,8}$/.test(pin)){ toast('PIN must be 4–8 digits.', 'err'); return false; }
      const done = (hash) => {
        const payload = {name:v.name, role:v.role, phone:v.phone, active:v.active};
        if (hash) payload.pinHash = hash;
        if (emp) Object.assign(emp, payload);
        else DB.employees.push(Object.assign({id:uid('em'), createdAt:new Date().toISOString()}, payload));
        audit(emp ? 'employee.updated' : 'employee.created', 'employee', emp ? emp.id : '', {after:{role:v.role}});
        saveDB(); render(); toast('Employee saved.');
      };
      if (pin) hashPin(pin).then(done); else done(null);
      return true;
