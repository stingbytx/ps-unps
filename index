function formModal(opts){
  const fields = opts.fields;
  const values = opts.values || {};
  const body = `<div class="grid2">${fields.map(f => {
    if (f.type === 'hidden') return '';
    const v = values[f.key] != null ? values[f.key] : (f.value != null ? f.value : '');
    const full = f.full || f.type === 'textarea' || f.type === 'checkbox';
    const span = full ? 'grid-column:1/-1' : '';
    let input = '';
    if (f.type === 'select'){
      input = `<select id="f_${f.key}" ${f.disabled ? 'disabled' : ''}>${(f.options || []).map(o => {
        const val = typeof o === 'object' ? o.value : o;
        const lab = typeof o === 'object' ? o.label : o;
        return `<option value="${attr(val)}" ${String(val) === String(v) ? 'selected' : ''}>${esc(lab)}</option>`;
      }).join('')}</select>`;
    } else if (f.type === 'textarea'){
      input = `<textarea id="f_${f.key}" rows="${f.rows || 3}" placeholder="${attr(f.placeholder || '')}">${esc(v)}</textarea>`;
    } else if (f.type === 'checkbox'){
      return `<label class="check" style="grid-column:1/-1"><input type="checkbox" id="f_${f.key}" ${v ? 'checked' : ''}> ${esc(f.label)}</label>`;
    } else if (f.type === 'static'){
      return `<div style="grid-column:1/-1" class="${f.className || ''}">${f.html || ''}</div>`;
    } else {
      const step = f.type === 'money' ? '0.01' : (f.step || 'any');
      input = `<input id="f_${f.key}" type="${f.type === 'money' ? 'number' : f.type}" value="${attr(v)}" placeholder="${attr(f.placeholder || '')}" ${f.min != null ? `min="${f.min}"` : ''} ${f.max != null ? `max="${f.max}"` : ''} step="${step}" ${f.disabled ? 'disabled' : ''} ${f.required ? 'required' : ''}>`;
    }
    return `<div class="field" style="${span}">${f.type === 'checkbox' ? '' : `<label>${esc(f.label)}${f.required ? ' *' : ''}</label>`}${input}${f.hint ? `<div class="hint">${esc(f.hint)}</div>` : ''}</div>`;
  }).join('')}</div>`;

  openModal({
    title: opts.title,
    body,
    size: opts.size || (fields.length > 6 ? 'wide' : ''),
    onMount: opts.onMount,
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label: opts.submit || 'Save', kind:'primary', onClick(){
        const out = {};
        for (const f of fields){
          if (f.type === 'checkbox'){ out[f.key] = $('#f_' + f.key).checked; continue; }
          if (f.type === 'static' || f.type === 'hidden') continue;
          const el = $('#f_' + f.key);
          if (!el) continue;
          let val = el.value;
          if (f.type === 'money') val = toCents(val);
          else if (f.type === 'number') val = val === '' ? 0 : Number(val);
          else val = String(val).trim();
          if (f.required && (val === '' || val === null)){ toast(f.label + ' is required.', 'err'); el.focus(); return false; }
          out[f.key] = val;
        }
        const res = opts.onSubmit(out);
        if (res === false) return false;
        return true;
      }}
    ]
  });
}

function pager(total, page, per, attrName){
  const pages = Math.ceil(total / per);
  if (pages <= 1) return '';
  return `<div style="display:flex;align-items:center;justify-content:space-between;padding-top:12px">
    <div class="tiny">Page ${page + 1} of ${pages} · ${total} records</div>
    <div style="display:flex;gap:6px">
      <button class="btn sm" data-page="${attrName}" data-dir="-1" ${page === 0 ? 'disabled' : ''}>Prev</button>
      <button class="btn sm" data-page="${attrName}" data-dir="1" ${page >= pages - 1 ? 'disabled' : ''}>Next</button>
    </div>
  </div>`;
}
function tableEmpty(msg, label, action){
