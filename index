function saveSettings(){
  const c = DB.config;
  const get = id => { const el = $('#' + id); return el ? el.value : undefined; };
  if (get('set_bizName') !== undefined) c.bizName = get('set_bizName').trim() || c.bizName;
  if (get('set_owner') !== undefined) c.owner = get('set_owner').trim();
  if (get('set_bizType') !== undefined) c.bizType = get('set_bizType');
  if (get('set_bizType2') !== undefined){ c.bizType = get('set_bizType2'); c.modules = Object.assign({}, PROFILES[c.bizType].modules); }
  if (get('set_country') !== undefined) c.country = get('set_country');
  if (get('set_currency') !== undefined) c.currency = get('set_currency');
  if (get('set_tz') !== undefined) c.tz = get('set_tz');
  if (get('set_phone') !== undefined) c.phone = get('set_phone');
  if (get('set_email') !== undefined) c.email = get('set_email');
  if (get('set_address') !== undefined) c.address = get('set_address');
  if (get('set_autoLock') !== undefined) c.autoLockMinutes = Number(get('set_autoLock')) || 0;
  if (get('set_dateFormat') !== undefined) c.dateFormat = get('set_dateFormat');
  if (get('set_taxMode') !== undefined) c.taxMode = get('set_taxMode');
  if (get('set_taxRate') !== undefined) c.taxRate = Number(get('set_taxRate')) || 0;
  if (get('set_taxLabel') !== undefined) c.taxLabel = get('set_taxLabel');
  if (get('set_discountThreshold') !== undefined) c.discountThreshold = Number(get('set_discountThreshold')) || 0;
  if (get('set_negStock') !== undefined) c.negStock = get('set_negStock') === '1';
  if (get('set_dailyTarget') !== undefined) c.dailyTarget = toCents(get('set_dailyTarget'));
  if (get('set_paper') !== undefined) c.paper = get('set_paper');
  if (get('set_receiptPrefix') !== undefined) c.receiptPrefix = get('set_receiptPrefix');
  if (get('set_footer') !== undefined) c.footer = get('set_footer');
  if (get('set_loyaltyOn') !== undefined){
    c.loyalty = c.loyalty || {};
    c.loyalty.enabled = $('#set_loyaltyOn').checked;
    c.loyalty.spendPer = Number(get('set_loyaltySpend')) || 100;
    c.loyalty.earnPer = Number(get('set_loyaltyEarn')) || 1;
  }
  const stock = $('[data-module="stock"]');
  if (stock) c.trackStock = stock.checked;
  $$('[data-module]').forEach(el => {
    const k = el.dataset.module;
    if (k === 'stock') return;
    if (k === 'loyalty'){ c.loyalty = c.loyalty || {}; c.loyalty.enabled = el.checked; return; }
    c.modules = c.modules || {};
    c.modules[k] = el.checked;
  });
  audit('settings.updated', 'config', 'config', {note:'Settings saved'});
  saveDB(); render(); toast('Settings saved.');
}

/* ---------------------------- backup / restore -------------------------- */
function exportBackup(){
  const payload = makeBackup();
  const stamp = isoDay(new Date());
  download(`unipos-backup-${stamp}.json`, JSON.stringify(payload, null, 2), 'application/json');
  audit('backup.created', 'system', '', {note: payload.counts.sales + ' sales included'});
  saveDB();
  toast('Backup downloaded.');
  render();
}
function restoreFromFile(file){
  const reader = new FileReader();
  reader.onload = () => {
    let obj;
    try{ obj = JSON.parse(String(reader.result)); }
    catch(e){ toast('That file is not valid JSON.', 'err'); return; }
    const v = validateBackup(obj);
    if (!v.ok){
      openModal({title:'Backup not valid', body:`<div class="notice">${icon('alert', 13)}<span>The file could not be restored:</span></div><ul style="font-size:12.5px;color:var(--text-2);padding-left:18px">${v.errors.map(e => `<li>${esc(e)}</li>`).join('')}</ul>`, size:'narrow', actions:[{label:'Close', kind:'ghost'}]});
      return;
    }
    const c = obj.counts || {};
    openModal({
      title:'Confirm restore', size:'narrow',
      body:`<p style="font-size:13px;line-height:1.6">This will replace everything currently stored for this business.</p>
        <div class="kv"><span>Business</span><b>${esc(obj.business || '—')}</b></div>
        <div class="kv"><span>Exported</span><b>${esc(fmtDT(obj.exportedAt))}</b></div>
        <div class="kv"><span>Products</span><b>${c.products || 0}</b></div>
        <div class="kv"><span>Sales</span><b>${c.sales || 0}</b></div>
        <div class="kv"><span>Customers</span><b>${c.customers || 0}</b></div>
        <div class="kv"><span>Audit events</span><b>${c.audit || 0}</b></div>
        <div class="notice">${icon('alert', 13)}<span>A safety copy of the current data will be downloaded first if your browser allows it.</span></div>`,
      actions:[
        {label:'Cancel', kind:'ghost'},
        {label:'Restore now', kind:'danger', onClick(){
          try{
            download(`unipos-pre-restore-${isoDay(new Date())}.json`, JSON.stringify(makeBackup(), null, 2), 'application/json');
          }catch(e){ /* optional */ }
          const restored = obj.data;
          if (!restored.meta) restored.meta = emptyDB().meta;
          DB = Object.assign(emptyDB(), restored);
          if (!Array.isArray(DB.sales)) DB.sales = [];
          DB.audit.unshift({id:uid('au'), at:new Date().toISOString(), userId:'system', userName:'System', action:'backup.restored', entity:'system', entityId:'', before:null, after:{business:obj.business}, note:'Restored from backup', result:'success'});
          if (!saveDB()){ toast('Restore could not be saved.', 'err', 6000); return; }
          CART = newCart(); saveCart();
          scanAlerts(); render();
          toast('Backup restored.');
        }}
      ]
    });
  };
  reader.readAsText(file);
}

function wipeData(){
  openModal({
    title:'Reset business data', size:'narrow',
    body:`<p style="font-size:13px;line-height:1.6">Type <b>DELETE</b> to remove all products, sales, customers and settings from this browser. Download a backup first — this cannot be undone.</p>
      <div class="field"><input id="wipeConfirm" placeholder="DELETE" autocomplete="off"></div>`,
