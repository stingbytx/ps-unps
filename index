function money(cents, opts){
  const o = opts || {};
  const m = curMeta();
  const dec = m.dec;
  const v = (Number(cents) || 0) / Math.pow(10, dec);
  const nf = new Intl.NumberFormat('en-US', {minimumFractionDigits:dec, maximumFractionDigits:dec});
  const body = nf.format(Math.abs(v));
  const sign = v < 0 ? '-' : '';
  if (o.plain) return sign + body;
  return sign + (o.code ? m.code + ' ' : m.symbol + ' ') + body;
}
