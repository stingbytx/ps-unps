function openReturn(saleId){
  const s = DB.sales.find(x => x.id === saleId);
  if (!s) return;
  const prev = s.refunds || [];
  const rows = s.items.map(i => {
    const returned = sum(prev, r => sum(r.items.filter(x => x.productId === i.productId), x => x.qty));
    const avail = i.qty - returned;
    return `<div class="pay-row" data-pid="${attr(i.productId)}" data-price="${i.price}" data-cost="${i.cost}" style="display:grid;grid-template-columns:1fr 90px 90px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid var(--line)">
      <div><div style="font-size:12.5px;font-weight:600">${esc(i.name)}</div><div class="tiny">${avail} of ${i.qty} returnable · ${esc(money(i.price))}</div></div>
      <input type="number" class="ret-qty" min="0" max="${avail}" step="1" value="0" style="height:32px;text-align:right" ${avail <= 0 ? 'disabled' : ''}>
      <div class="tiny" style="text-align:right">max ${avail}</div>
    </div>`;
  }).join('');
  openModal({
    title:'Refund ' + s.no, size:'wide',
    body:`
      <div class="notice">${icon('alert', 13)}<span>Returns are recorded as linked records — the original sale is never edited or deleted.</span></div>
      ${rows}
      <div class="grid2">
        <div class="field"><label>Refund method</label><select id="retMethod">${PAY_METHODS.map(m => `<option>${m}</option>`).join('')}</select></div>
        <div class="field"><label>Reason</label><input id="retReason" placeholder="e.g. damaged item"></div>
      </div>
      <label class="check"><input type="checkbox" id="retRestock" checked> Put returned items back into stock</label>
    `,
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:'Process refund', kind:'danger', keepOpen:true, onClick(){
        const sel = $$('.ret-qty').map(inp => ({
          productId: inp.closest('.pay-row').dataset.pid,
          qty: Number(inp.value) || 0
        })).filter(x => x.qty > 0);
        if (!sel.length){ toast('Enter at least one quantity to return.', 'err'); return false; }
        const res = returnSale(saleId, sel, $('#retMethod').value, $('#retReason').value.trim(), $('#retRestock').checked);
        if (!res.ok){ toast(res.msg, 'err'); return false; }
        toast('Refund recorded · ' + money(res.ret.total));
        closeModal();
        render();
        return false;
      }}
    ]
  });
}

