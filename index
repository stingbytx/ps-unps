function openNewPurchase(){
  if (!DB.suppliers.length){ toast('Add a supplier first.', 'warn'); return; }
  const rows = [];
  const productOptions = DB.products.filter(p => p.active !== false);
  openModal({
    title:'New purchase order', size:'wide',
    body:`
      <div class="field"><label>Supplier</label><select id="poSupplier">${DB.suppliers.map(s => `<option value="${attr(s.id)}">${esc(s.name)}</option>`).join('')}</select></div>
      <div class="field">
        <label>Add products</label>
        <div style="display:flex;gap:7px">
          <select id="poProduct" style="flex:1">${productOptions.map(p => `<option value="${attr(p.id)}">${esc(p.name)} — cost ${esc(money(p.cost))}</option>`).join('')}</select>
          <input id="poQty" type="number" min="1" value="1" style="width:80px" aria-label="Quantity">
          <button type="button" class="btn primary" id="poAdd">Add</button>
        </div>
      </div>
      <div id="poLines" class="table-wrap"><div class="empty">No lines yet.</div></div>
      <div class="field"><label>Note</label><input id="poNote" placeholder="Optional reference"></div>
    `,
    onMount(body){
      const draw = () => {
        const wrap = $('#poLines', body);
        if (!rows.length){ wrap.innerHTML = '<div class="empty">No lines yet.</div>'; return; }
        wrap.innerHTML = `<table class="tbl"><thead><tr><th>Product</th><th class="t-right">Qty</th><th class="t-right">Unit cost</th><th class="t-right">Line total</th><th></th></tr></thead>
          <tbody>${rows.map((r, i) => `<tr><td>${esc(r.name)}</td>
            <td class="t-num"><input type="number" min="1" value="${r.qty}" data-pol-qty="${i}" style="width:64px;height:28px;text-align:right"></td>
            <td class="t-num"><input type="number" min="0" step="0.01" value="${fromCents(r.cost)}" data-pol-cost="${i}" style="width:86px;height:28px;text-align:right"></td>
            <td class="t-num t-strong">${esc(money(r.cost * r.qty))}</td>
            <td class="t-right"><button class="mini-x" data-pol-del="${i}">${icon('x', 11)}</button></td></tr>`).join('')}</tbody></table>
          <div style="display:flex;justify-content:space-between;padding:10px 12px;font-weight:700">Total <span>${esc(money(sum(rows, r => r.cost * r.qty)))}</span></div>`;
        $$('[data-pol-qty]', wrap).forEach(inp => inp.onchange = () => { rows[+inp.dataset.polQty].qty = Math.max(1, Number(inp.value) || 1); draw(); });
        $$('[data-pol-cost]', wrap).forEach(inp => inp.onchange = () => { rows[+inp.dataset.polCost].cost = toCents(inp.value); draw(); });
        $$('[data-pol-del]', wrap).forEach(b => b.onclick = () => { rows.splice(+b.dataset.polDel, 1); draw(); });
      };
      $('#poAdd', body).onclick = () => {
        const pid = $('#poProduct', body).value;
        const p = productById(pid);
        const qty = Math.max(1, Number($('#poQty', body).value) || 1);
        if (!p) return;
        const ex = rows.find(r => r.productId === pid);
        if (ex) ex.qty += qty; else rows.push({productId:pid, name:p.name, qty, cost:p.cost});
        draw();
      };
      draw();
    },
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:'Create order', kind:'primary', keepOpen:true, onClick(){
        if (!rows.length){ toast('Add at least one product line.', 'err'); return false; }
        const po = {
          id:uid('po'), no:'PO-' + (DB.meta.seq = (DB.meta.seq || 1000) + 1), supplierId:$('#poSupplier').value,
          at:new Date().toISOString(), items: rows.map(r => ({...r})),
          total: sum(rows, r => r.cost * r.qty), status:'ordered', note: $('#poNote').value.trim(), paid:0
        };
        DB.purchases.unshift(po);
        audit('purchase.created', 'purchase', po.id, {after:{no:po.no, total:po.total}});
        saveDB(); closeModal(); render(); toast('Purchase order created.'); return false;
      }}
    ]
  });
}

function receivePurchase(poId){
  const po = DB.purchases.find(p => p.id === poId);
  if (!po) return;
  openModal({
    title:'Receive ' + po.no, size:'wide',
    body:`<div class="notice info">${icon('info', 13)}<span>Receiving will increase stock, create movement records and add the total to the supplier balance unless marked paid.</span></div>
      ${po.items.map((i, idx) => `<div style="display:grid;grid-template-columns:1fr 90px 100px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid var(--line)">
        <div><div style="font-size:12.5px;font-weight:600">${esc(i.name)}</div><div class="tiny">ordered ${i.qty}</div></div>
        <input type="number" class="rec-qty" data-idx="${idx}" min="0" max="${i.qty}" value="${i.qty}" style="height:32px;text-align:right">
        <input type="number" class="rec-cost" data-idx="${idx}" min="0" step="0.01" value="${fromCents(i.cost)}" style="height:32px;text-align:right">
      </div>`).join('')}
      <div class="grid2">
        <label class="check"><input type="checkbox" id="poPaid"> Paid in full</label>
        <div class="tiny" style="align-self:center">Quantities above 0 will be added to stock.</div>
      </div>`,
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:'Receive goods', kind:'primary', keepOpen:true, onClick(){
        const qty = $$('.rec-qty').map(x => Number(x.value) || 0);
        const cost = $$('.rec-cost').map(x => toCents(x.value));
        let total = 0;
        po.items.forEach((i, idx) => {
          if (qty[idx] > 0){
            adjustStock(i.productId, qty[idx], 'purchase', po.id, 'Received ' + po.no);
            const p = productById(i.productId);
            if (p && cost[idx]) p.cost = cost[idx];
            total += cost[idx] * qty[idx];
          }
          i.qty = qty[idx];
          i.cost = cost[idx];
        });
        po.status = 'received'; po.receivedAt = new Date().toISOString(); po.total = total;
        const sup = DB.suppliers.find(s => s.id === po.supplierId);
        if (sup && !$('#poPaid').checked){ sup.balance = (sup.balance || 0) + total; po.paid = 0; }
        else po.paid = total;
        audit('purchase.received', 'purchase', po.id, {after:{total, paid:po.paid}});
        saveDB(); closeModal(); render(); scanAlerts(); toast('Goods received and stock updated.'); return false;
      }}
    ]
  });
}

