function openProductImport(){
  openModal({
    title:'Import products', size:'wide',
    body:`
      <div class="notice info">${icon('info', 13)}<span>CSV columns: name, sku, barcode, category, cost, price, stock, minStock, unit. Duplicate SKUs are skipped.</span></div>
      <div style="display:flex;gap:8px">
        <label class="btn" style="cursor:pointer">${icon('upload', 14)} Choose CSV<input type="file" id="csvFile" accept=".csv,text/csv" hidden></label>
        <button class="btn" data-action="download-template">${icon('download', 14)} Template</button>
      </div>
      <div id="importPreview" class="tiny">No file selected.</div>
    `,
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:'Import rows', kind:'primary', keepOpen:true, onClick(){
        const data = window.__importRows;
        if (!data || !data.length){ toast('Choose a CSV file first.', 'err'); return false; }
        let added = 0, skipped = 0;
        data.forEach(r => {
          const name = (r.name || '').trim();
          if (!name){ skipped++; return; }
          const sku = (r.sku || '').trim();
          if (sku && DB.products.some(p => (p.sku || '').toLowerCase() === sku.toLowerCase())){ skipped++; return; }
          let cat = DB.categories.find(c => c.name.toLowerCase() === (r.category || '').toLowerCase());
          if (!cat && r.category){ cat = {id:uid('cat'), name:r.category}; DB.categories.push(cat); }
          DB.products.push({
            id:uid('pr'), name, sku, barcode:(r.barcode || '').trim(), category: cat ? cat.id : '',
            cost:toCents(r.cost), price:toCents(r.price), wholesale:toCents(r.price),
            stock:Number(r.stock) || 0, minStock:Number(r.minStock) || 0, unit:(r.unit || 'pc').trim(),
            taxRate:null, active:true, trackStock:true, description:'', brand:'', image:'',
            variants:[], createdAt:new Date().toISOString(), updatedAt:new Date().toISOString()
          });
          added++;
        });
        audit('products.imported', 'product', '', {note:added + ' added, ' + skipped + ' skipped'});
        saveDB(); closeModal(); render();
        toast(`${added} product(s) imported${skipped ? ', ' + skipped + ' skipped' : ''}.`);
        return false;
      }}
    ],
    onMount(){
      $('#csvFile').onchange = e => {
        const file = e.target.files[0];
        if (!file) return;
        const rd = new FileReader();
        rd.onload = () => {
          const rows = parseCSV(String(rd.result));
          if (rows.length < 2){ $('#importPreview').textContent = 'The file needs a header row and at least one data row.'; return; }
          const head = rows[0].map(h => h.trim());
          const map = {};
          head.forEach((h, i) => { map[h.toLowerCase().replace(/\s+/g, '')] = i; });
          const get = (r, k) => { const idx = map[k.toLowerCase()]; return idx == null ? '' : (r[idx] || ''); };
          window.__importRows = rows.slice(1).map(r => ({
            name:get(r,'name'), sku:get(r,'sku'), barcode:get(r,'barcode'), category:get(r,'category'),
            cost:get(r,'cost'), price:get(r,'price'), stock:get(r,'stock'), minStock:get(r,'minstock'), unit:get(r,'unit')
          }));
          $('#importPreview').innerHTML = `<div style="margin-top:6px"><b>${window.__importRows.length}</b> rows detected. Preview of the first 5:</div>
            <div class="table-wrap" style="margin-top:6px"><table class="tbl"><thead><tr><th>Name</th><th>SKU</th><th>Price</th><th>Stock</th></tr></thead>
            <tbody>${window.__importRows.slice(0,5).map(r => `<tr><td>${esc(r.name)}</td><td>${esc(r.sku)}</td><td>${esc(r.price)}</td><td>${esc(r.stock)}</td></tr>`).join('')}</tbody></table></div>`;
        };
        rd.readAsText(file);
      };
    }
  });
}
