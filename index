function openStockCount(){
  const prods = DB.products.filter(p => p.active !== false);
  if (!prods.length){ toast('No products to count.', 'warn'); return; }
  openModal({
    title:'Physical stock count', size:'wide',
    body:`<div class="notice info">${icon('info', 13)}<span>Enter counted quantities. Differences are written as stock-count adjustments with a movement record.</span></div>
      <div class="table-wrap"><table class="tbl"><thead><tr><th>Product</th><th class="t-right">System</th><th class="t-right">Counted</th></tr></thead>
      <tbody>${prods.map(p => `<tr><td>${esc(p.name)}<div class="tiny">${esc(p.sku || '')}</div></td><td class="t-num">${p.stock}</td>
        <td class="t-num"><input type="number" class="count-in" data-pid="${attr(p.id)}" step="0.001" value="${p.stock}" style="width:88px;height:30px;text-align:right"></td></tr>`).join('')}</tbody></table></div>`,
    actions:[
      {label:'Cancel', kind:'ghost'},
      {label:'Apply count', kind:'primary', keepOpen:true, onClick(){
        let changes = 0;
        $$('.count-in').forEach(inp => {
          const p = productById(inp.dataset.pid);
          const counted = Number(inp.value);
          if (!p || !isFinite(counted)) return;
          const diff = Math.round((counted - p.stock) * 1000) / 1000;
          if (diff !== 0){ adjustStock(p.id, diff, 'stock count', '', 'Physical count'); changes++; }
        });
        audit('stock.counted', 'inventory', '', {note:changes + ' products adjusted'});
        saveDB(); closeModal(); render();
        toast(changes ? changes + ' product(s) adjusted.' : 'Count matched the system exactly.');
        return false;
      }}
    ]
  });
}

